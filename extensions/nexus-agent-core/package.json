{
  "name": "@openclaw/nexus-agent-core",
  "version": "2026.9.4",
  "private": true,
  "description": "Nexus Agent Core plugin (Stage 1 Task module; Stage 0 runtime spikes)",
  "type": "module",
  "files": [
    "dist/**",
    "skills/**",
    "openclaw.plugin.json"
  ],
  "dependencies": {
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "@openclaw/gateway-protocol": "workspace:*",
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "workerEntries": [
        "./src/store/sqlite-store.worker.ts",
        "./src/spikes/spike1-sqlite.worker.ts"
      ]
    },
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "cd ../.. && TSX_TSCONFIG_PATH=./tsconfig.json node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/nexus-agent-core",
      "copy": "cd ../.. && TSX_TSCONFIG_PATH=./tsconfig.json node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/nexus-agent-core --copy",
      "buildOutputs": [
        "openclaw.plugin.json"
      ]
    }
  },
  "scripts": {
    "build:dist": "node scripts/build-dist.mjs"
  }
}
