# Optional: default AI provider baked into the one-click macOS installer
# (scripts/build-mac-installer.sh / scripts/package-mac-installer.sh).
#
# Quick start:
# 1) Copy this file to `installer.env` at the repo root.
# 2) Fill in the values below.
# 3) Keep real secrets out of git -- installer.env is gitignored.
#
# What this does: if installer.env exists when the installer is built, its
# values are baked in PLAINTEXT into the installer app bundle's Resources
# and used to finish `openclaw onboard` on the end user's Mac with a working
# model already configured -- they land straight in the chat window instead
# of OpenClaw.app's own first-run "pick a model" screen.
#
# This is meant for a SHARED default backend you are comfortable handing to
# everyone who receives the installer built from it (e.g. an internal vLLM
# endpoint), not a personal API key. Anyone who unzips/inspects the built
# .app can read these values back out in plain text.
#
# Leave this file absent (the default) to skip this entirely: the installer
# still does everything else non-interactively, and the end user just picks
# a provider themselves in OpenClaw.app, same as installing it normally.
#
# These are separate from this repo's own .env (used by the gateway/CLI at
# runtime when run from source) so the two never mix.

OPENCLAW_INSTALLER_DEFAULT_AI_PROVIDER=vllm
OPENCLAW_INSTALLER_DEFAULT_AI_BASE_URL=http://127.0.0.1:8000/v1
OPENCLAW_INSTALLER_DEFAULT_AI_MODEL=your-model-id
OPENCLAW_INSTALLER_DEFAULT_AI_API_KEY=

# Optional local-model (llama.cpp) fallback: a HuggingFace repo id, bundled
# at build time (a prebuilt llama-server binary for this build's arch --
# see scripts/build-mac-installer.sh) and downloaded from HuggingFace at
# first launch. Registered as a *backup* model once it's running --
# --custom-as-backup on `openclaw onboard` -- it never replaces the
# OPENCLAW_INSTALLER_DEFAULT_AI_* model above. Leave this absent to skip
# the whole feature (no binary bundled, nothing downloaded). Without a
# pinned file, the newest release's most-preferred quantization is
# auto-selected from the repo; pin one explicitly with "repo:filename.gguf",
# e.g. Qwen/Qwen2.5-1.5B-Instruct-GGUF:qwen2.5-1.5b-instruct-q4_k_m.gguf
OPENCLAW_INSTALLER_DEFAULT_LLAMA_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF
OPENCLAW_LLAMA_VERSION=b11149
